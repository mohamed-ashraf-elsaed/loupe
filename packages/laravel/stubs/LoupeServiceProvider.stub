<?php

namespace App\Providers;

use Illuminate\Support\Facades\Gate;
use Illuminate\Support\ServiceProvider;

class LoupeServiceProvider extends ServiceProvider
{
    /**
     * Bootstrap Loupe authorization.
     */
    public function boot(): void
    {
        $this->gate();
    }

    /**
     * Decide who can use Loupe.
     *
     * "loupe:use"   → who sees the in-app feedback widget.
     * "loupe:admin" → who can open the triage dashboard.
     *
     * Return true for the users you want to grant access to. In the `local`
     * environment, config('loupe.allow_in_local') (true by default) still lets
     * every signed-in user in before these gates run; set it to false to apply
     * them locally too. An authorize closure in config('loupe.authorize.*') or a
     * Loupe::useWhen()/adminWhen() closure overrides these gates everywhere.
     */
    protected function gate(): void
    {
        // Loupe is open to any authenticated user in the `local` environment
        // (see config('loupe.allow_in_local')). These gates decide access in
        // every OTHER environment — list the people who may use it in production.
        Gate::define('loupe:use', function ($user) {
            return in_array($user->email, [
                // 'teammate@example.com',
            ]);
        });

        Gate::define('loupe:admin', function ($user) {
            return in_array($user->email, [
                // 'admin@example.com',
            ]);
        });
    }
}
